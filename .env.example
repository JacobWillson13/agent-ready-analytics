# Copy to ~/.config/ara/env and fill in. Never commit real values.
export CLOUDSDK_CONFIG=$HOME/.config/gcloud-ara   # isolated gcloud login for this project
export DBT_PROFILES_DIR=$HOME/.dbt                # MetricFlow needs this set explicitly
export GCP_PROJECT=your-gcp-project-id
export ANTHROPIC_API_KEY=
export LANGSMITH_API_KEY=
export LANGSMITH_TRACING=true
export LANGSMITH_PROJECT=agent-ready-analytics
export GITHUB_TOKEN=$(gh auth token)
export DESTINATION__BIGQUERY__CREDENTIALS__PROJECT_ID=$GCP_PROJECT
export DESTINATION__BIGQUERY__LOCATION=US
